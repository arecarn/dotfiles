#!/bin/sh

# Repo-local pre-push gate for dotfiles: lint only.
#
# Invoked by ~/.config/git/hooks/pre-push, which core.hooksPath makes the only
# hook git itself runs. The global checks (fixup/WIP, branch name) run there, so
# this file must not repeat them -- it would run each twice.
#
# Lint only, not provision: provision is too slow to gate every push and is a
# near no-op on an already-provisioned machine, so provision and stow breakage
# only shows up in CI. Watch the run after pushing.

exit_code=0

echo "pre-push: running linters..."
if ! uv run invoke lint; then
    echo "pre-push: lint failed — fix issues before pushing"
    exit_code=1
else
    echo "pre-push: lint passed"
fi

exit ${exit_code}

#!/usr/bin/env python3
"""Launcher for the agent-knowledge resolver CLI.

Stowed by the `agents` package -- alongside .config/ai-knowledge/bundles.yaml, so
the config and the launchers that read it install as one unit -- and lands in
~/bin. A Pi extension, a Claude Code hook, or an OpenCode plugin can then invoke
it by absolute path with no knowledge of this checkout. The adapters hardcode
that destination; tests/test_knowledge_launcher.py is what keeps them and
manage.stow._STOW_PACKAGES agreeing. It is deliberately only a path fix plus a
call: the logic lives in manage/knowledge/cli.py, which `inv lint` and the tests
cover (an extensionless script matches neither the *.py nor the *.sh glob).
"""

import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent.parent))

from manage.knowledge.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""Claude Code SessionStart hook: emit the superpowers-toggle disabled note.

Registered in ~/.claude/settings.json by `inv claude-setup`, not shipped as a
plugin -- see agent-knowledge-session-start for why. Deliberately only a path
fix plus a call: the logic lives in manage/superpowers_toggle_hooks.py, which
`inv lint` and the tests cover.

The repo root is searched for rather than counted to, because this file runs
through a stow symlink whose depth differs from its path in the checkout.
"""

import pathlib
import sys

for candidate in pathlib.Path(__file__).resolve().parents:
    if (candidate / "manage" / "superpowers_toggle_hooks.py").is_file():
        sys.path.insert(0, str(candidate))
        break

from manage.superpowers_toggle_hooks import session_start  # noqa: E402

if __name__ == "__main__":
    sys.exit(session_start())

#!/bin/sh

# The helper scripts below are called by bare name and live in ~/bin. A
# non-interactive, non-login shell (agent tool calls, cron, editors) never reads
# a startup file, so ~/bin may be missing from PATH; add it here rather than
# depend on the caller.
case ":$PATH:" in
    *":${HOME}/bin:"*) ;;
    *) PATH="${HOME}/bin:${PATH}" ;;
esac
export PATH

exit_code=0

pre_commit_white_space_check.sh
exit_code=$((exit_code + $?))

pre_commit_ascii_filename_check.sh
exit_code=$((exit_code + $?))

pre_commit_copyright_check.sh
exit_code=$((exit_code + $?))

pre_commit_shebang_check.sh
exit_code=$((exit_code + $?))

if [ "${exit_code}" != 0 ]; then
    echo "pre-commit: pass -n or --no-verify to bypass pre-commit hooks"
fi

exit ${exit_code}

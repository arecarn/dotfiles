#!/usr/bin/env python3
"""Claude Code SessionStart hook: emit the knowledge catalog as extra context.

Registered in ~/.claude/settings.json by `inv claude-setup`, not shipped as a
plugin: Claude Code loads plugins its own plugin manager installed, so a
directory stowed into ~/.claude/plugins is never scanned.

Extensionless on purpose: Claude Code prepends `bash` to any hook command
containing `.sh`, and this is Python. See
docs/gotchas/claude-code-prepends-bash-to-any-hook-command-containing-sh.md.

Deliberately only a path fix plus a call, for the same reason as
scripts/bin/agent-knowledge: the behaviour belongs in manage/knowledge/hooks.py,
which `inv lint` and the tests cover.

The repo root is searched for rather than counted to, because this file runs
through a stow symlink whose depth differs from its path in the checkout.
"""

import pathlib
import sys

for candidate in pathlib.Path(__file__).resolve().parents:
    if (candidate / "manage" / "knowledge" / "hooks.py").is_file():
        sys.path.insert(0, str(candidate))
        break

from manage.knowledge.hooks import session_start  # noqa: E402

if __name__ == "__main__":
    sys.exit(session_start())

{
  "compilerOptions": {
    // pi ships an ESM "exports" map; the "node"/"bundler" resolvers do not read
    // it correctly, so its types resolve to nothing. Keep both keys on nodenext.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    // pi's shipped .d.ts do not survive a lib check under nodenext: pi-ai's
    // declarations import JSON without an import attribute (TS1543), and
    // @anthropic-ai/sdk and @google/genai add TS2307/TS2552. 49 errors, none in
    // this repo's code. Declarations are still used to check our own files, so
    // dropping this flag buys nothing and re-buries our errors under theirs.
    "skipLibCheck": true
  },
  // One set of TypeScript files, kept identical to what lint_typescript's guard
  // in tasks.py finds. The guard is only sound while that holds: a file the guard
  // sees but tsc does not is a TS18003 "no inputs" failure, and the reverse is a
  // file nothing type-checks. biome.json's "**/*.ts" is a superset of this set,
  // since it does not read the exclude below.
  //
  // Both patterns are needed and neither is redundant. TypeScript's "**" does not
  // descend into directories whose name starts with ".", so "**/*.ts" alone
  // matches nothing under pi/.pi/agent/extensions/ -- every extension in this
  // repo would go unchecked while the lint still passed green. The second pattern
  // is what reaches dot-directories. It is also what brings .venv and .cache into
  // scope, which is the only reason "exclude" needs entries for them; node_modules
  // and __pycache__ are not dotted, so the first pattern reaches them and their
  // excludes are load-bearing on their own.
  // Limit: a doubly nested dot-directory (a/.b/c/.d/x.ts) is still missed. No
  // path in this repo has two, and closing it costs one pattern per nesting level.
  "include": ["**/*.ts", "**/.*/**/*.ts"],
  // Mirrors EXCLUDE_DIRS in tasks.py; change both together, or lint_typescript's
  // guard and tsc's input set diverge.
  "exclude": [
    "**/node_modules",
    "**/.git",
    "**/.venv",
    "**/.cache",
    "**/__pycache__",
    "**/.superpowers",
    "**/.worktrees"
  ]
}
